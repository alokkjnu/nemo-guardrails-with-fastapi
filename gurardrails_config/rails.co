##########################################################################
# INPUT SAFETY
##########################################################################

define flow self check input
    $unsafe = execute self_check_input
    if $unsafe == "yes"
        bot refuse to respond


define flow jailbreak check
    $jailbreak = execute detect_jailbreak
    if $jailbreak == "yes"
        bot refuse to respond


define flow pii check
    $pii = execute detect_pii
    if $pii =="yes"
        bot say "Sensitive personal data detected. Please remove it"


#########################################################################
# TOPIC CONTROL
#########################################################################

define flow topic control
    $allowed = execute check_allowed_topic
    if $allowed == "no"
        bot say "This topic is not allowed."

define flow enforce allowed topics

    user intent not in ["general","product","support"]
    bot refuse to respond

##########################################################################
# OUTPUT SAFETY
##########################################################################
define flow self check output
    $unsafe = excute self_check_output
    if $unsafe == "yes"
        bot refuse to respond

def flow fact check output
    $halluncination = execute detect_hallucination
    if $halluncination == "yes"
        bot say "I'm not fully confident in that answer. Please verify"


#########################################################################
# AGENT / TOOL SECURITY
#########################################################################


